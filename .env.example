# =============================================================================
# 智能衣橱 — 环境变量模板（仅作示例，不要在这里填真实密钥）
#
# 真实密钥请写在「.env」里（与 package.json 同目录）。.env 已被 .gitignore 忽略，
# 不会被提交；本文件 .env.example 会随项目更新，填在这里的密钥可能被覆盖或误提交。
#
# 使用方法：复制本文件为 .env → 只在 .env 里填写密钥 → 重启 npm run dev
# =============================================================================

# -----------------------------------------------------------------------------
# Kimi（Moonshot）— 衣服识别 + AI 搭配（必填其一变量名）
# 获取密钥：https://platform.kimi.ai/
# -----------------------------------------------------------------------------
KIMI_API_KEY=

# 与 KIMI_API_KEY 二选一即可
# MOONSHOT_API_KEY=

# 可选，默认 kimi-k2.6
# KIMI_MODEL=kimi-k2.6

# 可选：本地自定义 Kimi 网关根地址（不要含 /v1/chat/completions）。生产 AI 功能需另行实现服务端代理
# KIMI_API_BASE=https://你的域名

# 国内站 https://platform.moonshot.cn 申请的密钥 → 填 cn（也可省略，默认先请求国内 api.moonshot.cn）
KIMI_MOONSHOT_HOST=cn

# 若密钥在 https://platform.kimi.ai 申请，请改为：KIMI_MOONSHOT_HOST=ai

# -----------------------------------------------------------------------------
# 火山引擎方舟 — 模特上身图 Seedream（必填）
# 控制台：https://console.volcengine.com/ark
# -----------------------------------------------------------------------------
ARK_API_KEY=

# 可选：默认 doubao-seedream-5-0-260128
# ARK_IMAGE_MODEL=doubao-seedream-5-0-260128

# 可选：自定义图片接口完整 URL（自建网关 / 其它地域）
# ARK_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations

# 可选：穿搭效果图最多传入几张单品参考图（默认 4，范围 1～10）。已在 vite.config define 中注入，修改后需重启 dev
# ARK_OUTFIT_MAX_REF_IMAGES=4

# -----------------------------------------------------------------------------
# AI 搭配 — 天气与地点（可选，写入前端可读的 VITE_ 变量）
# 未开启定位、拒绝定位或非 https 时，将用该城市名通过 Open-Meteo 查天气并写入搭配提示（如：上海）
# VITE_OUTFIT_DEFAULT_CITY=上海

# -----------------------------------------------------------------------------
# 抖音分享链接 → 封面图（可选）
# 本地 npm run dev 已内置 /api/douyin-preview，无需填写。
# 若静态部署生产包，需自建同源网关实现相同接口，再把根地址写在这里（不要末尾 /）
# -----------------------------------------------------------------------------
# VITE_DOUYIN_PREVIEW_URL=https://你的域名

# =============================================================================
# 公开静态构建（GitHub Actions / Vercel）
#
# 生产构建强制排除 KIMI_API_KEY、MOONSHOT_API_KEY、ARK_API_KEY。
# 不要把提供商密钥写进前端代码或 VITE_ 变量，也不要为静态部署配置这些密钥。
# 线上 AI 功能暂停，直到实现保存密钥并鉴权的服务端代理。
# 本文件中的密钥变量仅供可信本机 npm run dev 使用。
# 非敏感配置仍可在构建时设置，例如 KIMI_MODEL、KIMI_MOONSHOT_HOST、
# ARK_IMAGE_MODEL、ARK_OUTFIT_MAX_REF_IMAGES、VITE_OUTFIT_DEFAULT_CITY。
# =============================================================================
